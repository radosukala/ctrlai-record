{
  "name": "ctrlai-record",
  "version": "1.0.0-alpha",
  "private": true,
  "description": "Ctrl AI: the public record of how AI behaves, kept by the people who use it.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev --port 4310",
    "build": "next build",
    "start": "next start --port 4310",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "steward": "tsx scripts/steward.ts",
    "vercel-build": "tsx scripts/migrate.ts && tsx scripts/seed.ts && next build"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/radosukala/ctrlai-record.git"
  },
  "homepage": "https://ctrlai.com"
}

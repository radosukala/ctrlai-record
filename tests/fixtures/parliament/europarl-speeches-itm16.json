{"data":[{"id":"eli/dl/event/MTG-PL-2026-10-06-OTH-2017097952600","type":"Activity","activity_date":"2026-10-06","activity_end_date":"2026-10-06T16:30:24.467+02:00","activity_id":"MTG-PL-2026-10-06-OTH-2017097952600","activity_label":{"en":"Effective measures to protect and empower children in the digital world (debate)"},"activity_start_date":"2026-10-06T16:30:01.881+02:00","had_activity_type":"def/ep-activities/PLENARY_DEBATE_SPEECH","had_participation":{"id":"eli/dl/participation/MTG-PL-2026-10-06-OTH-2017097952600_37312","type":"Participation","had_participant_person":["person/37312"],"participation_role":"def/ep-roles/SPEAKER"},"recorded_in_a_realization_of":[{"id":"eli/dl/doc/CRE-10-2026-10-06-OTH-2017097952600","type":"WorkSubdivision","is_part_of":"eli/dl/doc/CRE-10-2026-10-06-ITM-016","number":"2-0333-0000","type_subdivision":"http://publications.europa.eu/resource/authority/subdivision/OTH","identifier":"CRE-10-2026-10-06-OTH-2017097952600","notation_speechId":"2017097952600","numbering":309,"originalLanguage":["http://publications.europa.eu/resource/authority/language/ENG"],"api:xmlFragment":{"en":"<oralStatements><speech endTime=\"2026-10-06T16:30:24.467\" startTime=\"2026-10-06T16:30:01.881\" xml:lang=\"en\"><from xml:lang=\"en\"><person refersTo=\"epdata:person/37312\">President</person>.</from><blockContainer><p xml:space=\"preserve\"><recordedTime time=\"2026-10-06T16:30:05.601+02:00\" type=\"startEvent\"/><time time=\"2026-10-06T16:30:05.601+02:00\">The</time> <time time=\"2026-10-06T16:30:06.121+02:00\">next</time> <time time=\"2026-10-06T16:30:08.641+02:00\">item</time> <time time=\"2026-10-06T16:30:09.191+02:00\">on</time> <time time=\"2026-10-06T16:30:09.381+02:00\">the</time> <time time=\"2026-10-06T16:30:09.471+02:00\">agenda</time> <time time=\"2026-10-06T16:30:09.841+02:00\">is</time> <time time=\"2026-10-06T16:30:10.071+02:00\">the</time> <time time=\"2026-10-06T16:30:10.131+02:00\">debate</time> <time time=\"2026-10-06T16:30:10.291+02:00\">on</time> <time time=\"2026-10-06T16:30:10.351+02:00\">the</time> <time time=\"2026-10-06T16:30:10.411+02:00\">Commission</time> <time time=\"2026-10-06T16:30:10.801+02:00\">statement</time> <time time=\"2026-10-06T16:30:11.671+02:00\">on</time> <time time=\"2026-10-06T16:30:11.731+02:00\">effective</time> <time time=\"2026-10-06T16:30:12.251+02:00\">measures</time> <time time=\"2026-10-06T16:30:13.281+02:00\">to</time> <time time=\"2026-10-06T16:30:13.391+02:00\">protect</time> <time time=\"2026-10-06T16:30:14.131+02:00\">and</time> <time time=\"2026-10-06T16:30:14.281+02:00\">empower</time> <time time=\"2026-10-06T16:30:14.861+02:00\">children</time> <time time=\"2026-10-06T16:30:15.291+02:00\">in</time> <time time=\"2026-10-06T16:30:15.431+02:00\">the</time> <time time=\"2026-10-06T16:30:15.511+02:00\">digital</time> <time time=\"2026-10-06T16:30:16.341+02:00\">world</time> <time time=\"2026-10-06T16:30:17.741+02:00\">(2026/2915(RSP)).</time><recordedTime time=\"2026-10-06T16:30:17.741+02:00\" type=\"endEvent\"/></p></blockContainer></speech></oralStatements>"}}],"inverse_consists_of":["eli/dl/event/MTG-PL-2026-10-06-PVCRE-ITM-16"]},{"id":"eli/dl/event/MTG-PL-2026-10-06-OTH-2017097959250","type":"Activity","activity_date":"2026-10-06","activity_end_date":"2026-10-06T17:12:35.346+02:00","activity_id":"MTG-PL-2026-10-06-OTH-2017097959250","activity_label":{"en":"Effective measures to protect and empower children in the digital world (debate)"},"activity_start_date":"2026-10-06T17:11:51.256+02:00","had_activity_type":"def/ep-activities/PLENARY_DEBATE_SPEECH","had_participation":{"id":"eli/dl/participation/MTG-PL-2026-10-06-OTH-2017097959250_257083","type":"Participation","had_participant_person":["person/257083"],"participation_role":"def/ep-roles/SPEAKER"},"recorded_in_a_realization_of":[{"id":"eli/dl/doc/CRE-10-2026-10-06-OTH-2017097959250","type":"WorkSubdivision","is_part_of":"eli/dl/doc/CRE-10-2026-10-06-ITM-016","number":"2-0358-0000","type_subdivision":"http://publications.europa.eu/resource/authority/subdivision/OTH","identifier":"CRE-10-2026-10-06-OTH-2017097959250","notation_speechId":"2017097959250","numbering":334,"originalLanguage":["http://publications.europa.eu/resource/authority/language/POR"],"api:xmlFragment":{"en":"<oralStatements><question endTime=\"2026-10-06T17:12:35.346\" startTime=\"2026-10-06T17:11:51.256\" xml:lang=\"pt-t-en-mtec\"><from xml:lang=\"pt-t-en-mtec\" xml:space=\"preserve\"><person refersTo=\"epdata:person/257083\">João Oliveira</person> (<organization refersTo=\"epdata:org/7036\">The Left</organization>), <process refersTo=\"\">Question under the blue card procedure</process>.</from><blockContainer><p xml:space=\"preserve\"><recordedTime time=\"2026-10-06T17:11:51.976+02:00\" type=\"startEvent\"/>Madam President, Mrs Hahn, it is clear the power that multinationals in the digital sector have achieved and their ability not only to influence, but to condition the development of children. And the commercial interest of these multinationals is antagonistic to the interest in balanced development and are children's. And my question to you is whether, from your perspective, from the perspective of liberals, it is possible to protect children without facing those multinationals that have that power in the digital sector? What if states should only be responsible for regulation or if we need to go further in order to have effective measures to protect children in the digital world?<recordedTime time=\"2026-10-06T17:12:34.676+02:00\" type=\"endEvent\"/></p></blockContainer></question></oralStatements>"}}],"inverse_consists_of":["eli/dl/event/MTG-PL-2026-10-06-PVCRE-ITM-16"]},{"id":"eli/dl/event/MTG-PL-2026-10-06-OTH-2017097959251","type":"Activity","activity_date":"2026-10-06","activity_end_date":"2026-10-06T17:13:10.468+02:00","activity_id":"MTG-PL-2026-10-06-OTH-2017097959251","activity_label":{"en":"Effective measures to protect and empower children in the digital world (debate)"},"activity_start_date":"2026-10-06T17:12:35.346+02:00","had_activity_type":"def/ep-activities/PLENARY_DEBATE_SPEECH","had_participation":{"id":"eli/dl/participation/MTG-PL-2026-10-06-OTH-2017097959251_197444","type":"Participation","had_participant_person":["person/197444"],"participation_role":"def/ep-roles/SPEAKER"},"recorded_in_a_realization_of":[{"id":"eli/dl/doc/CRE-10-2026-10-06-OTH-2017097959251","type":"WorkSubdivision","is_part_of":"eli/dl/doc/CRE-10-2026-10-06-ITM-016","number":"2-0359-0000","type_subdivision":"http://publications.europa.eu/resource/authority/subdivision/OTH","identifier":"CRE-10-2026-10-06-OTH-2017097959251","notation_speechId":"2017097959251","numbering":335,"originalLanguage":["http://publications.europa.eu/resource/authority/language/DEU"],"api:xmlFragment":{"en":"<oralStatements><answer endTime=\"2026-10-06T17:13:10.468\" startTime=\"2026-10-06T17:12:35.346\" xml:lang=\"de-t-en-mtec\"><from xml:lang=\"de-t-en-mtec\" xml:space=\"preserve\"><person refersTo=\"epdata:person/197444\">Svenja Hahn</person> (<organization refersTo=\"epdata:org/7035\">Renew</organization>), <process refersTo=\"\">Answer to a question about the ‘blue card’ procedure</process>.</from><blockContainer><p xml:space=\"preserve\"><recordedTime time=\"2026-10-06T17:12:37.096+02:00\" type=\"startEvent\"/>I was wondering if you were listening to me, dear colleague. Because I said very clearly that we have to take platforms into account. I was born in 1989. I can still remember the curtains in the video counters, where I didn't get behind it as a child. And we also need to talk about it: What rules do we need in the digital space, in digital coexistence, that children are safe and protected? But the logic cannot be to lock out children, but to create safe online spaces for them, and that's where the platforms are responsible.<recordedTime time=\"2026-10-06T17:13:08.536+02:00\" type=\"endEvent\"/></p></blockContainer></answer></oralStatements>"}}],"inverse_consists_of":["eli/dl/event/MTG-PL-2026-10-06-PVCRE-ITM-16"]},{"id":"eli/dl/event/MTG-PL-2026-10-06-OTH-2017097959298","type":"Activity","activity_date":"2026-10-06","activity_id":"MTG-PL-2026-10-06-OTH-2017097959298","activity_label":{"en":"Effective measures to protect and empower children in the digital world (debate)"},"had_activity_type":"def/ep-activities/PROCEEDING_ACTIVITY","recorded_in_a_realization_of":[{"id":"eli/dl/doc/CRE-10-2026-10-06-OTH-2017097959298","type":"WorkSubdivision","is_part_of":"eli/dl/doc/CRE-10-2026-10-06-ITM-016","number":"2-0382-0000","type_subdivision":"http://publications.europa.eu/resource/authority/subdivision/OTH","identifier":"CRE-10-2026-10-06-OTH-2017097959298","notation_speechId":"2017097959298","numbering":358,"originalLanguage":["http://publications.europa.eu/resource/authority/language/ENG"],"api:xmlFragment":{"en":"<communication><narrative xml:lang=\"en\">Catch-the-eye procedure</narrative></communication>"}}],"inverse_consists_of":["eli/dl/event/MTG-PL-2026-10-06-PVCRE-ITM-16"]}],"meta":{"total":4}}

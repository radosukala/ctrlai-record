# Copy to .env.local for local development, or set these in your host's environment.

# Postgres connection string. Leave empty locally to use the embedded database in .data/pglite.
DATABASE_URL=

# A long random string (e.g. `openssl rand -base64 32`). Salts network fingerprints. Required in production.
CTRL_SECRET=

# The public address of the site, used for share links, canonical URLs and the same-origin check.
PUBLIC_ORIGIN=https://ctrlai.com

# Local development only: lets you check your own runs from one machine. Never set this in production.
# CTRL_ALLOW_SAME_NETWORK=1

# Optional: migrate the database on first request instead of in the build step.
# CTRL_AUTO_MIGRATE=1

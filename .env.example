# Copy to .env.local for local work. Never commit real values.
# The site runs without any of these; the newsletter appears only when the first two are set (then redeploy).

# Resend: https://resend.com/api-keys  (Full access: contacts and broadcasts need it)
RESEND_API_KEY=
# The segment that holds confirmed subscribers. Run `npm run newsletter -- setup` to create it and print the id.
RESEND_SEGMENT_ID=

# Optional
# NEWSLETTER_FROM="Ctrl AI <hello@ctrlai.com>"
# NEWSLETTER_REPLY_TO=
# PUBLIC_ORIGIN=https://ctrlai.com
